# --- Django ---
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

# --- Database ---
# Set DB_ENGINE=postgres to use PostgreSQL instead of the default SQLite.
DB_ENGINE=sqlite
DB_NAME=budgetdb
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Email (SMTP) ---
# Default is console backend (prints emails to terminal) — good for local dev.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For real delivery, switch to: django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
